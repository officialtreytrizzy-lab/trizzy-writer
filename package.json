{
  "name": "trizzy-writer",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "dev:turbopack": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:hot": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "lightning:setup": "bash scripts/lightning-setup.sh",
    "lightning:start": "bash scripts/lightning-start.sh",
    "lightning:status": "bash scripts/lightning-status.sh",
    "lightning:stop": "bash scripts/lightning-stop.sh",
    "lightning:smoke": "python3 scripts/lightning-smoke.py",
    "check:ar": "node scripts/check-inside-ar.mjs",
    "check:assistant": "npx tsx scripts/check-unified-assistant.ts",
    "vault:index": "npx tsx scripts/index-current-repo.ts",
    "vault:seed": "npx tsx scripts/seed-trey-knowledge.ts",
    "train:data": "npx tsx scripts/build-training-dataset.ts",
    "train:validate": "npx tsx scripts/build-training-dataset.ts --check",
    "train:preflight": "python3 training/preflight.py",
    "train:qlora": "python3 training/train_qlora.py",
    "train:evaluate": "python3 training/evaluate_adapter.py",
    "train:merge": "python3 training/merge_adapter.py",
    "train:export-gguf": "bash training/export_gguf.sh",
    "train:remediation-data": "npx tsx scripts/build-remediation-dataset.ts",
    "train:remediation-validate": "npx tsx scripts/build-remediation-dataset.ts --check",
    "train:remediate": "python3 training/train_qlora.py --config training/config.remediation.json",
    "train:evaluate-v3": "python3 training/evaluate_adapter.py --config training/config.remediation.json",
    "train:merge-v3": "python3 training/merge_adapter.py --config training/config.remediation.json",
    "train:v4-data": "npx tsx scripts/build-remediation-v4-dataset.ts",
    "train:v4-validate": "npx tsx scripts/build-remediation-v4-dataset.ts --check",
    "train:v4": "python3 training/train_qlora.py --config training/config.v4.json",
    "train:evaluate-v4": "python3 training/evaluate_adapter.py --config training/config.v4.json",
    "train:merge-v4": "python3 training/merge_adapter.py --config training/config.v4.json",
    "train:v5-data": "npx tsx scripts/build-remediation-v5-dataset.ts",
    "train:v5-validate": "npx tsx scripts/build-remediation-v5-dataset.ts --check",
    "train:v5": "python3 training/train_qlora.py --config training/config.v5.json",
    "train:evaluate-v5": "python3 training/evaluate_adapter.py --config training/config.v5.json",
    "train:merge-v5": "python3 training/merge_adapter.py --config training/config.v5.json",
    "train:v6-data": "npx tsx scripts/build-remediation-v5-dataset.ts",
    "train:v6-validate": "npx tsx scripts/build-remediation-v5-dataset.ts --check",
    "train:v6": "python3 training/train_qlora.py --config training/config.v6.json",
    "train:evaluate-v6": "python3 training/evaluate_adapter.py --config training/config.v6.json",
    "train:merge-v6": "python3 training/merge_adapter.py --config training/config.v6.json"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "next": "^16.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
