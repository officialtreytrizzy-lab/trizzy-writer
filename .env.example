# Model backend
# Local development defaults to Ollama. Lightning uses .env.lightning.example.
TRIZZY_MODEL_PROVIDER=ollama
TRIZZY_MODEL_API_URL=http://127.0.0.1:11434/api/chat
TRIZZY_MODEL_API_TOKEN=
TRIZZY_MODEL_NAME=qwen3:1.7b

# Firebase web configuration. Leave blank to use local-only storage.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Inside A&R live research. The default providers require no API key.
TRIZZY_RESEARCH_ENABLED=true
TRIZZY_OFFICIAL_URLS=https://www.treytrizzy.com
